# AugmentOS SDK API Key
AUGMENTOS_API_KEY=your_augment_api_key
AUGMENTOS_PACKAGE_NAME=your_package_name

# Spotify API credentials
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# Web
WEB_URL=http://localhost
WEB_PORT=4040
REDIRECT_URI=http://localhost:4040/callback
AUTH_PORT=4041

# For local development, you'll need a local Postgres instance and its connection URL.
DATABASE_URL="postgresql://user:password@host:port/database"

# Encryption
TOKEN_ENCRYPTION_KEY=32_bit_key

# Logging
NODE_ENV=state_of_app